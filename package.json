{
  "name": "caliper-check",
  "version": "0.3.0",
  "description": "Stress-test a web page in a real browser and see what breaks: overflow, clipped text, broken layouts and small tap targets, with screenshots and the CSS fix.",
  "keywords": [
    "css",
    "layout",
    "overflow",
    "responsive",
    "visual-testing",
    "ui-testing",
    "accessibility",
    "wcag",
    "playwright",
    "cli"
  ],
  "author": "Arul Raaj",
  "homepage": "https://github.com/Arul-Raaj/caliper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arul-Raaj/caliper.git"
  },
  "bugs": {
    "url": "https://github.com/Arul-Raaj/caliper/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "caliper-check": "dist/caliper.js",
    "caliper": "dist/caliper.js"
  },
  "files": [
    "dist/caliper.js",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
